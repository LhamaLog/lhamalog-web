# Copie para .env na raiz. O Git ignora .env e .env.local.
# O Docker Compose lê .env. O Vite (npm run dev e npm run build) lê .env
# e, se existir, deixa .env.local sobrescrever esses valores.
# Uma linha por variável, sem aspas.
#
# Chave PUBLICÁVEL da Clerk (Dashboard > API keys): pk_test_ ou pk_live_.
# Nunca grave CLERK_SECRET_KEY, sk_test_ ou sk_live_ neste arquivo.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_COLE_AQUI

# Origem que o NAVEGADOR usa para chamar o Core. Não use o nome de um serviço Docker.
VITE_API_URL=http://localhost:8080

# Opcional. O padrão publica o site só em 127.0.0.1:5173.
# WEB_BIND_ADDRESS=127.0.0.1
# WEB_PORT=5173

# Opcional, só na alternativa de desenvolvimento (compose.dev.yaml).
# No Docker Desktop para Windows, use true se a recarga não perceber arquivos salvos.
# WATCH_POLLING=false
